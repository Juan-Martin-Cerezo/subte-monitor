{
  "name": "subte-monitor",
  "version": "0.1.0",
  "description": "Live tracking for the Buenos Aires subway: GTFS-Realtime telemetry, arrivals, service alerts, accessibility data and a step-free route planner.",
  "license": "MIT",
  "homepage": "https://subte-monitor.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Juan-Martin-Cerezo/subte-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Juan-Martin-Cerezo/subte-monitor/issues"
  },
  "keywords": [
    "buenos-aires",
    "subte",
    "gtfs-realtime",
    "transit",
    "nextjs",
    "prisma",
    "leaflet",
    "open-data"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
